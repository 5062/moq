LTTNG_UST_TRACEPOINT_ENUM(moq_trace, socket_outcome,
	LTTNG_UST_TP_ENUM_VALUES(
		lttng_ust_field_enum_value("success", MOQ_TRACE_SOCKET_OUTCOME_SUCCESS)
		lttng_ust_field_enum_value("pending", MOQ_TRACE_SOCKET_OUTCOME_PENDING)
