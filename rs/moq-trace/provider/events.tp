		lttng_ust_field_integer(uint64_t, trace_id, event->trace_id)
		lttng_ust_field_enum(moq_trace, object_phase, uint8_t, phase, event->phase)
		lttng_ust_field_enum(moq_trace, edge, uint8_t, edge, event->edge)
		lttng_ust_field_integer(uint8_t, has_outcome, event->has_outcome)
		lttng_ust_field_enum(moq_trace, object_outcome, uint8_t, outcome, event->outcome)
	)
)

