	)
)

LTTNG_UST_TRACEPOINT_EVENT(moq_trace, moq_object_start,
	LTTNG_UST_TP_ARGS(const struct moq_trace_moq_object_start *, event),
	LTTNG_UST_TP_FIELDS(
		lttng_ust_field_integer(uint64_t, timestamp_ns, event->timestamp_ns)
		lttng_ust_field_integer(uint64_t, trace_id, event->trace_id)
		lttng_ust_field_integer(uint64_t, logical_group, event->logical_group)
		lttng_ust_field_integer(uint64_t, logical_frame, event->logical_frame)
		lttng_ust_field_integer(uint8_t, has_session_id, event->has_session_id)
		lttng_ust_field_integer(uint64_t, session_id, event->session_id)
		lttng_ust_field_integer(uint8_t, has_connection_id, event->has_connection_id)
		lttng_ust_field_integer(uint64_t, connection_id, event->connection_id)
		lttng_ust_field_enum(moq_trace, direction, uint8_t, direction, event->direction)
		lttng_ust_field_enum(moq_trace, protocol, uint8_t, protocol, event->protocol)
		lttng_ust_field_integer(uint64_t, track_alias, event->track_alias)
		lttng_ust_field_integer(uint64_t, group_id, event->group_id)
		lttng_ust_field_integer(uint64_t, object_id, event->object_id)
		lttng_ust_field_integer(uint8_t, has_stream_id, event->has_stream_id)
		lttng_ust_field_integer(uint64_t, stream_id, event->stream_id)
		lttng_ust_field_integer(uint8_t, has_stream_offset_start, event->has_stream_offset_start)
		lttng_ust_field_integer(uint64_t, stream_offset_start, event->stream_offset_start)
		lttng_ust_field_integer(uint64_t, sample_rate, event->sample_rate)
	)
)

LTTNG_UST_TRACEPOINT_EVENT(moq_trace, moq_object_end,
	LTTNG_UST_TP_ARGS(const struct moq_trace_moq_object_end *, event),
