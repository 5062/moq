		lttng_ust_field_integer(uint64_t, stream_offset_end, event->stream_offset_end)
		lttng_ust_field_integer(uint64_t, payload_bytes, event->payload_bytes)
	)
)

LTTNG_UST_TRACEPOINT_EVENT(moq_trace, moq_object_phase,
	LTTNG_UST_TP_ARGS(const struct moq_trace_moq_object_phase *, event),
