LTTNG_UST_TRACEPOINT_ENUM(moq_trace, packet_outcome,
	LTTNG_UST_TP_ENUM_VALUES(
		lttng_ust_field_enum_value("success", MOQ_TRACE_PACKET_OUTCOME_SUCCESS)
		lttng_ust_field_enum_value("malformed", MOQ_TRACE_PACKET_OUTCOME_MALFORMED)
		lttng_ust_field_enum_value("authentication_failed", MOQ_TRACE_PACKET_OUTCOME_AUTHENTICATION_FAILED)
		lttng_ust_field_enum_value("dropped", MOQ_TRACE_PACKET_OUTCOME_DROPPED)
		lttng_ust_field_enum_value("abandoned", MOQ_TRACE_PACKET_OUTCOME_ABANDONED)
	)
