#include "interface.h"

LTTNG_UST_TRACEPOINT_ENUM(moq_trace, direction,
	LTTNG_UST_TP_ENUM_VALUES(
		lttng_ust_field_enum_value("rx", MOQ_TRACE_DIRECTION_RX)
		lttng_ust_field_enum_value("tx", MOQ_TRACE_DIRECTION_TX)
	)
)

LTTNG_UST_TRACEPOINT_ENUM(moq_trace, protocol,
	LTTNG_UST_TP_ENUM_VALUES(
		lttng_ust_field_enum_value("moq_transport", MOQ_TRACE_PROTOCOL_MOQ_TRANSPORT)
	)
)

LTTNG_UST_TRACEPOINT_ENUM(moq_trace, edge,
	LTTNG_UST_TP_ENUM_VALUES(
		lttng_ust_field_enum_value("start", MOQ_TRACE_EDGE_START)
		lttng_ust_field_enum_value("done", MOQ_TRACE_EDGE_DONE)
	)
)

LTTNG_UST_TRACEPOINT_ENUM(moq_trace, packet_space,
	LTTNG_UST_TP_ENUM_VALUES(
		lttng_ust_field_enum_value("initial", MOQ_TRACE_PACKET_SPACE_INITIAL)
		lttng_ust_field_enum_value("handshake", MOQ_TRACE_PACKET_SPACE_HANDSHAKE)
		lttng_ust_field_enum_value("zero_rtt", MOQ_TRACE_PACKET_SPACE_ZERO_RTT)
		lttng_ust_field_enum_value("data", MOQ_TRACE_PACKET_SPACE_DATA)
	)
)

LTTNG_UST_TRACEPOINT_ENUM(moq_trace, object_phase,
	LTTNG_UST_TP_ENUM_VALUES(
		lttng_ust_field_enum_value("header_parse", MOQ_TRACE_OBJECT_PHASE_HEADER_PARSE)
		lttng_ust_field_enum_value("create", MOQ_TRACE_OBJECT_PHASE_CREATE)
		lttng_ust_field_enum_value("payload_read", MOQ_TRACE_OBJECT_PHASE_PAYLOAD_READ)
		lttng_ust_field_enum_value("frame_commit", MOQ_TRACE_OBJECT_PHASE_FRAME_COMMIT)
		lttng_ust_field_enum_value("clone", MOQ_TRACE_OBJECT_PHASE_CLONE)
		lttng_ust_field_enum_value("header_encode", MOQ_TRACE_OBJECT_PHASE_HEADER_ENCODE)
		lttng_ust_field_enum_value("payload_write", MOQ_TRACE_OBJECT_PHASE_PAYLOAD_WRITE)
	)
)

LTTNG_UST_TRACEPOINT_ENUM(moq_trace, object_outcome,
	LTTNG_UST_TP_ENUM_VALUES(
		lttng_ust_field_enum_value("success", MOQ_TRACE_OBJECT_OUTCOME_SUCCESS)
		lttng_ust_field_enum_value("failed", MOQ_TRACE_OBJECT_OUTCOME_FAILED)
		lttng_ust_field_enum_value("abandoned", MOQ_TRACE_OBJECT_OUTCOME_ABANDONED)
	)
)

LTTNG_UST_TRACEPOINT_ENUM(moq_trace, packet_phase,
	LTTNG_UST_TP_ENUM_VALUES(
		lttng_ust_field_enum_value("header_parse", MOQ_TRACE_PACKET_PHASE_HEADER_PARSE)
		lttng_ust_field_enum_value("routing", MOQ_TRACE_PACKET_PHASE_ROUTING)
		lttng_ust_field_enum_value("scheduling", MOQ_TRACE_PACKET_PHASE_SCHEDULING)
		lttng_ust_field_enum_value("header_unprotect", MOQ_TRACE_PACKET_PHASE_HEADER_UNPROTECT)
		lttng_ust_field_enum_value("payload_decrypt", MOQ_TRACE_PACKET_PHASE_PAYLOAD_DECRYPT)
		lttng_ust_field_enum_value("frame_process", MOQ_TRACE_PACKET_PHASE_FRAME_PROCESS)
		lttng_ust_field_enum_value("frame_encode", MOQ_TRACE_PACKET_PHASE_FRAME_ENCODE)
		lttng_ust_field_enum_value("packet_encrypt", MOQ_TRACE_PACKET_PHASE_PACKET_ENCRYPT)
