#!/usr/bin/env just --justfile

set working-directory := '../..'

default:
    just check

check:
    python -m unittest discover -s tools/moq-trace/tests -v
    uv sync --no-install-workspace
    uv run --no-sync ruff check tools/moq-trace
    uv run --no-sync ruff format --check tools/moq-trace

ci FILES="":
    #!/usr/bin/env bash
    set -euo pipefail
    files='{{ FILES }}'
    if [[ -n "$files" ]] && ! grep -qE '^(tools/moq-trace/|rs/moq-trace/|rs/moq-trace-lttng-sys/|rs/moq-net/|rs/moq-relay/|Cargo\.(toml|lock)$|flake\.nix$|nix/)' <<<"$files"; then
        echo "trace ci: no tracing inputs changed; skipping."
        exit 0
    fi
    just trace check

fix:
    uv sync --no-install-workspace
    uv run --no-sync ruff check --fix tools/moq-trace
    uv run --no-sync ruff format tools/moq-trace

clean:
    find tools/moq-trace -type d \( -name __pycache__ -o -name .ruff_cache \) -prune -exec rm -rf {} +
